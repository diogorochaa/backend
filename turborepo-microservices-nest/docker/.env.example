POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Supabase (um projeto = mesma base `postgres`, tabelas users + orders + outbox) ---
# Pooler (runtime, porta 6543):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (migrations, porta 5432):
# DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"
# USERS_DATABASE_URL e ORDERS_DATABASE_URL = mesma DATABASE_URL no Supabase

# --- Local Docker (um banco lógico por serviço) ---
USERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/users_db?schema=public
ORDERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders_db?schema=public
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public
BILLING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing_db?schema=public
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db?schema=public

# RabbitMQ (eventos entre microserviços)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# API Gateway
GATEWAY_PORT=4000
USERS_SERVICE_URL=http://localhost:3000
